# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/nourfi_db
SUPABASE_DATABASE_URL=postgresql://postgres.your_ref:your_password@aws-0-region.pooler.supabase.com:5432/postgres

# LLM / Groq API Configuration
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
MAX_GENERATION_TOKENS=900

# Security & Encryption
ENCRYPTION_KEY=your_base64_encryption_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# Email Verification (Gmail SMTP)
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password


# --- optional: second LLM provider (OpenAI-compatible) ---
# SECOND_API_KEY=
# SECOND_BASE_URL=
# SECOND_MODEL=

# --- optional overrides (defaults shown) ---
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# TOP_K=5
# LLM_TPM_LIMIT=7000        # 0 on a paid tier
# MIN_SIM=0                 # similarity gate, 0 = off
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
